# Where cards come from: "memory" (built-in seed, no database needed) or "postgres"
CARD_SOURCE=memory

# Required when CARD_SOURCE=postgres. Server-side only — never prefix with NEXT_PUBLIC_.
# Local Docker:  postgres://truode:truode@localhost:5433/truode  (npm run db:up)
# Supabase:      Project Settings → Database → Connection string (URI)
DATABASE_URL=postgres://truode:truode@localhost:5433/truode

# Public site URL, used for absolute Open Graph image links
NEXT_PUBLIC_SITE_URL=http://localhost:3000
